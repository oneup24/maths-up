VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog — get from posthog.com > Project Settings > Project API Key
VITE_POSTHOG_KEY=
# Optional: override region host (default: https://us.i.posthog.com)
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry — get from sentry.io > Project Settings > Client Keys (DSN)
# Format: https://<publicKey>@o<orgId>.ingest.us.sentry.io/<projectId>
# ⚠️ The '@o' between publicKey and orgId is required; missing it causes
#    console errors ("Invalid Sentry Dsn") that fail Lighthouse best-practices.
# VITE_SENTRY_DSN=https://examplePublicKey@o0000000000000000.ingest.us.sentry.io/0000000000000000
